<?xml version="1.0" ?>
<!--
  empty_night.world
  Gazebo Classic / SDF 1.6 world for drone show simulation.

  Environment:
    - Near-zero ambient lighting to simulate a night sky
    - Single directional moonlight for subtle shadowing
    - Ground plane with dark grass texture
    - ODE physics with Earth gravity
    - Sky dome with stars and moon

  Compatible with: Gazebo 11 (Classic), gz-sim 7+ (Fortress / Garden)
-->
<sdf version="1.6">
  <world name="empty_night">

    <!-- ================================================================
         Physics: ODE with realistic gravity and timestep
         ================================================================ -->
    <physics type="ode" name="default_physics">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.81</gravity>
      <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
          <use_dynamic_moi_rescaling>true</use_dynamic_moi_rescaling>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ================================================================
         Scene: Night sky — near-zero ambient light
         ================================================================ -->
    <scene>
      <!-- Ambient: very dark, barely visible starlight -->
      <ambient>0.02 0.02 0.04 1.0</ambient>

      <!-- Background: deep night sky blue -->
      <background>0.003 0.003 0.012 1.0</background>

      <!-- Disable default shadows (they look wrong at night) -->
      <shadows>false</shadows>

      <!-- Sky dome with stars -->
      <sky>
        <time>22</time>          <!-- 10 PM — fully dark -->
        <sunrise>6</sunrise>
        <sunset>20</sunset>
        <wind_speed>0.0</wind_speed>
        <wind_direction>0.0</wind_direction>
        <clouds>
          <speed>0.0</speed>
          <direction>0.0</direction>
          <humidity>0.0</humidity>
          <mean_size>0.0</mean_size>
          <ambient>0.01 0.01 0.02 1.0</ambient>
        </clouds>
      </sky>

      <!-- Fog: light ground haze for realism -->
      <fog>
        <color>0.01 0.01 0.02 1.0</color>
        <type>none</type>
        <start>200</start>
        <end>1000</end>
        <density>0.0</density>
      </fog>
    </scene>

    <!-- ================================================================
         Lighting: moonlight-level directional light
         ================================================================ -->
    <light type="directional" name="moon_light">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <!-- Very dim cool-blue moonlight -->
      <diffuse>0.04 0.045 0.06 1.0</diffuse>
      <specular>0.01 0.01 0.015 1.0</specular>
      <attenuation>
        <range>10000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Ground fill — tiny upward ambient bounce -->
    <light type="directional" name="ground_bounce">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 0.1 0 0 0</pose>
      <diffuse>0.01 0.01 0.01 1.0</diffuse>
      <specular>0 0 0 1.0</specular>
      <attenuation>
        <range>500</range>
        <constant>1.0</constant>
        <linear>0.0</linear>
        <quadratic>0.0</quadratic>
      </attenuation>
      <direction>0 0 1</direction>
    </light>

    <!-- ================================================================
         Ground plane — dark grass / tarmac surface
         ================================================================ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <bounce/>
            <contact>
              <ode>
                <min_depth>0.001</min_depth>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1000 1000</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
            <!-- Override colour to near-black for night -->
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.08 0.08 0.08 1.0</diffuse>
            <specular>0.01 0.01 0.01 1.0</specular>
            <emissive>0 0 0 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================
         GPS origin — set to a typical show site (London, Hyde Park)
         ================================================================ -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>51.5074</latitude_deg>
      <longitude_deg>-0.1278</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- ================================================================
         GUI camera — positioned to view the performance area
         ================================================================ -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-80 -80 50 0 0.5 0.78</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
