<?xml version="1.0" ?>
<!--
  model.sdf — Show Drone Quadrotor (Gazebo Classic / SDF 1.6)

  Physical specification:
    Frame:      250mm motor-to-motor, carbon fibre
    All-up mass: 0.85 kg
    Motors:     4× brushless, 2306 2450kV
    Props:      5-inch, two CW and two CCW
    Battery:    6S 4000mAh LiPo, 22.2V nominal
    LED array:  Addressable RGB ring on bottom payload link
    Sensors:    IMU (MPU-6000), GPS (u-blox M9N RTK)

  Inertia tensor (kg·m²) computed for a 250mm frame:
    Ixx ≈ 3.2e-3  (roll)
    Iyy ≈ 3.2e-3  (pitch)
    Izz ≈ 5.5e-3  (yaw)

  Rotor layout (top view, props spinning outward):
    3 (CCW) — 1 (CW)
       |   X   |
    2 (CW)  — 4 (CCW)

    Motor 1: front-right  (+x, -y)  CW
    Motor 2: back-left    (-x, +y)  CW
    Motor 3: front-left   (+x, +y)  CCW
    Motor 4: back-right   (-x, -y)  CCW
-->
<sdf version="1.6">
  <model name="show_drone">

    <!-- Enable self-collide so rotors don't clip the body -->
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- ================================================================
         BODY LINK — main airframe + battery
         ================================================================ -->
    <link name="base_link">
      <pose>0 0 0 0 0 0</pose>

      <!-- Inertia -->
      <inertial>
        <mass>0.85</mass>
        <pose>0 0 0 0 0 0</pose>
        <inertia>
          <ixx>3.2e-3</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>3.2e-3</iyy>
          <iyz>0</iyz>
          <izz>5.5e-3</izz>
        </inertia>
      </inertial>

      <!-- Visual: main frame box approximation -->
      <visual name="frame_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.25 0.04</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>

      <!-- Visual: arm cross (simplified) -->
      <visual name="arm_visual_x">
        <pose>0 0 0.005 0 0 0</pose>
        <geometry>
          <box>
            <size>0.27 0.018 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>
      <visual name="arm_visual_y">
        <pose>0 0 0.005 0 0 1.5708</pose>
        <geometry>
          <box>
            <size>0.27 0.018 0.008</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <!-- Collision: simplified box -->
      <collision name="base_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.27 0.27 0.07</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <kp>1e6</kp>
              <kd>1e3</kd>
            </ode>
          </contact>
          <friction>
            <ode>
              <mu>0.3</mu>
              <mu2>0.3</mu2>
            </ode>
          </friction>
        </surface>
      </collision>

      <!-- IMU sensor -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <visualize>false</visualize>
        <imu>
          <angular_velocity>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2.0e-4</stddev>
                <bias_mean>7.5e-6</bias_mean>
                <bias_stddev>8e-7</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2.0e-4</stddev>
                <bias_mean>7.5e-6</bias_mean>
                <bias_stddev>8e-7</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>2.0e-4</stddev>
                <bias_mean>7.5e-6</bias_mean>
                <bias_stddev>8e-7</bias_stddev>
              </noise>
            </z>
          </angular_velocity>
          <linear_acceleration>
            <x>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </x>
            <y>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.017</stddev>
                <bias_mean>0.1</bias_mean>
                <bias_stddev>0.001</bias_stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- GPS sensor (RTK-grade noise) -->
      <sensor name="gps" type="gps">
        <pose>0 0 0.02 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <gps>
          <position_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.10</stddev>   <!-- 10 cm horizontal RTK -->
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.15</stddev>   <!-- 15 cm vertical -->
              </noise>
            </vertical>
          </position_sensing>
          <velocity_sensing>
            <horizontal>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
              </noise>
            </horizontal>
            <vertical>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.05</stddev>
              </noise>
            </vertical>
          </velocity_sensing>
        </gps>
      </sensor>

    </link>

    <!-- ================================================================
         ROTOR LINKS & JOINTS
         4 rotors at corners of 250mm frame.
         Motor positions at ±0.125m from centre.
         ================================================================ -->

    <!-- === ROTOR 1: front-right (+x, -y), CW spinning === -->
    <link name="rotor_1">
      <pose>0.125 -0.125 0.025 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.66e-5</iyy><iyz>0</iyz>
          <izz>1.66e-5</izz>
        </inertia>
      </inertial>
      <visual name="rotor_1_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>   <!-- 5-inch prop radius -->
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.5 0.7</ambient>
          <diffuse>0.1 0.1 0.8 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_1_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.004</damping>
        </dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
    </joint>

    <!-- === ROTOR 2: back-left (-x, +y), CW spinning === -->
    <link name="rotor_2">
      <pose>-0.125 0.125 0.025 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.66e-5</iyy><iyz>0</iyz>
          <izz>1.66e-5</izz>
        </inertia>
      </inertial>
      <visual name="rotor_2_visual">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.5 0.7</ambient>
          <diffuse>0.1 0.1 0.8 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_2_collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
    </joint>

    <!-- === ROTOR 3: front-left (+x, +y), CCW spinning === -->
    <link name="rotor_3">
      <pose>0.125 0.125 0.025 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.66e-5</iyy><iyz>0</iyz>
          <izz>1.66e-5</izz>
        </inertia>
      </inertial>
      <visual name="rotor_3_visual">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.05 0.05 0.7</ambient>
          <diffuse>0.8 0.1 0.1 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_3_collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 -1</xyz>   <!-- CCW -->
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
    </joint>

    <!-- === ROTOR 4: back-right (-x, -y), CCW spinning === -->
    <link name="rotor_4">
      <pose>-0.125 -0.125 0.025 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>9.75e-7</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.66e-5</iyy><iyz>0</iyz>
          <izz>1.66e-5</izz>
        </inertia>
      </inertial>
      <visual name="rotor_4_visual">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.5 0.05 0.05 0.7</ambient>
          <diffuse>0.8 0.1 0.1 0.7</diffuse>
        </material>
      </visual>
      <collision name="rotor_4_collision">
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.0635</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="rotor_4_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_4</child>
      <axis>
        <xyz>0 0 -1</xyz>   <!-- CCW -->
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
        <dynamics><damping>0.004</damping></dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
    </joint>

    <!-- ================================================================
         LED PAYLOAD LINK — RGB ring light array on bottom
         Fixed to base_link via fixed joint.
         ================================================================ -->
    <link name="led_payload">
      <pose>0 0 -0.025 0 0 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia>
          <ixx>1.0e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1.0e-5</iyy><iyz>0</iyz>
          <izz>1.8e-5</izz>
        </inertia>
      </inertial>

      <!-- Visual: ring approximated as a thin torus (cylinder in SDF) -->
      <visual name="led_ring_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.006</length>
            <radius>0.055</radius>
          </cylinder>
        </geometry>
        <material>
          <!-- Default white; colour is overridden at runtime by the LED plugin -->
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
          <specular>0.5 0.5 0.5 1.0</specular>
          <emissive>1.0 1.0 1.0 1.0</emissive>
        </material>
      </visual>

      <!-- Collision: small disk -->
      <collision name="led_collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.006</length>
            <radius>0.055</radius>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <joint name="led_joint" type="fixed">
      <parent>base_link</parent>
      <child>led_payload</child>
    </joint>

    <!-- ================================================================
         LANDING GEAR — 4 legs at corners
         ================================================================ -->
    <link name="leg_fl">
      <pose>0.08 0.08 -0.04 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia>
        <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz>
      </inertia></inertial>
      <visual name="leg_fl_v"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      <collision name="leg_fl_c"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry>
      <surface><contact><ode><kp>1e6</kp><kd>100</kd></ode></contact></surface>
      </collision>
    </link>
    <joint name="leg_fl_j" type="fixed"><parent>base_link</parent><child>leg_fl</child></joint>

    <link name="leg_fr">
      <pose>0.08 -0.08 -0.04 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia>
        <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz>
      </inertia></inertial>
      <visual name="leg_fr_v"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      <collision name="leg_fr_c"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry>
      <surface><contact><ode><kp>1e6</kp><kd>100</kd></ode></contact></surface>
      </collision>
    </link>
    <joint name="leg_fr_j" type="fixed"><parent>base_link</parent><child>leg_fr</child></joint>

    <link name="leg_rl">
      <pose>-0.08 0.08 -0.04 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia>
        <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz>
      </inertia></inertial>
      <visual name="leg_rl_v"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      <collision name="leg_rl_c"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry>
      <surface><contact><ode><kp>1e6</kp><kd>100</kd></ode></contact></surface>
      </collision>
    </link>
    <joint name="leg_rl_j" type="fixed"><parent>base_link</parent><child>leg_rl</child></joint>

    <link name="leg_rr">
      <pose>-0.08 -0.08 -0.04 0 0 0</pose>
      <inertial><mass>0.005</mass><inertia>
        <ixx>1e-7</ixx><ixy>0</ixy><ixz>0</ixz>
        <iyy>1e-7</iyy><iyz>0</iyz><izz>1e-7</izz>
      </inertia></inertial>
      <visual name="leg_rr_v"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      <collision name="leg_rr_c"><geometry><cylinder>
        <length>0.06</length><radius>0.004</radius>
      </cylinder></geometry>
      <surface><contact><ode><kp>1e6</kp><kd>100</kd></ode></contact></surface>
      </collision>
    </link>
    <joint name="leg_rr_j" type="fixed"><parent>base_link</parent><child>leg_rr</child></joint>

    <!-- ================================================================
         ROTOR PHYSICS PLUGINS
         Uses libgazebo_motor_model.so from RotorS / PX4 Gazebo package.
         Thrust and drag constants for a 5-inch prop at 2450kV on 6S:
           - Thrust constant kT ≈ 8.54858e-6 N/(rad/s)²
           - Drag constant kD  ≈ 0.016 * kT  (torque/thrust ratio)
         ================================================================ -->

    <!-- Rotor 1: CW (turning direction = -1) -->
    <plugin name="rotor_1_motor" filename="libgazebo_motor_model.so">
      <robotNamespace></robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1047.2</maxRotVelocity>        <!-- ~10,000 RPM in rad/s -->
      <motorConstant>8.54858e-6</motorConstant>
      <momentConstant>1.3677e-7</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-5</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/0</motorSpeedPubTopic>
    </plugin>

    <!-- Rotor 2: CW -->
    <plugin name="rotor_2_motor" filename="libgazebo_motor_model.so">
      <robotNamespace></robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1047.2</maxRotVelocity>
      <motorConstant>8.54858e-6</motorConstant>
      <momentConstant>1.3677e-7</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.06428e-5</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/1</motorSpeedPubTopic>
    </plugin>

    <!-- Rotor 3: CCW -->
    <plugin name="rotor_3_motor" filename="libgazebo_motor_model.so">
      <robotNamespace></robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1047.2</maxRotVelocity>
      <motorConstant>8.54858e-6</motorConstant>
      <momentConstant>1.3677e-7</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.06428e-5</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/2</motorSpeedPubTopic>
    </plugin>

    <!-- Rotor 4: CCW -->
    <plugin name="rotor_4_motor" filename="libgazebo_motor_model.so">
      <robotNamespace></robotNamespace>
      <jointName>rotor_4_joint</jointName>
      <linkName>rotor_4</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1047.2</maxRotVelocity>
      <motorConstant>8.54858e-6</motorConstant>
      <momentConstant>1.3677e-7</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.06428e-5</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-6</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/3</motorSpeedPubTopic>
    </plugin>

    <!-- ================================================================
         MULTIROTOR PHYSICS PLUGIN
         Handles: atmosphere, gravity, aerodynamic drag on the body.
         ================================================================ -->
    <plugin name="multirotor_base" filename="libgazebo_multirotor_base_plugin.so">
      <robotNamespace></robotNamespace>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <odometrySubTopic>odometry_sensor1</odometrySubTopic>
      <odometryPubTopic>odometry</odometryPubTopic>
      <odometryFrameId>odom</odometryFrameId>
      <childFrameId>base_link</childFrameId>
    </plugin>

    <!-- ================================================================
         IMU PLUGIN
         ================================================================ -->
    <plugin name="imu_plugin" filename="libgazebo_imu_plugin.so">
      <robotNamespace></robotNamespace>
      <linkName>base_link</linkName>
      <imuTopic>/imu</imuTopic>
      <gyroscopeNoiseDensity>0.0003394</gyroscopeNoiseDensity>
      <gyroscopeRandomWalk>3.8785e-5</gyroscopeRandomWalk>
      <gyroscopeBiasCorrelationTime>1000.0</gyroscopeBiasCorrelationTime>
      <gyroscopeTurnOnBiasSigma>8.7266e-5</gyroscopeTurnOnBiasSigma>
      <accelerometerNoiseDensity>0.004</accelerometerNoiseDensity>
      <accelerometerRandomWalk>6.0e-4</accelerometerRandomWalk>
      <accelerometerBiasCorrelationTime>300.0</accelerometerBiasCorrelationTime>
      <accelerometerTurnOnBiasSigma>0.196</accelerometerTurnOnBiasSigma>
    </plugin>

    <!-- ================================================================
         GPS PLUGIN
         ================================================================ -->
    <plugin name="gps_plugin" filename="libgazebo_gps_plugin.so">
      <robotNamespace></robotNamespace>
      <gpsTopic>/gps</gpsTopic>
      <gpsVelTopic>/gps_vel</gpsVelTopic>
      <updateRate>10</updateRate>
      <horPosStdDev>0.10</horPosStdDev>    <!-- RTK-grade, ~10 cm -->
      <verPosStdDev>0.15</verPosStdDev>
      <horVelStdDev>0.05</horVelStdDev>
      <verVelStdDev>0.05</verVelStdDev>
    </plugin>

  </model>
</sdf>
